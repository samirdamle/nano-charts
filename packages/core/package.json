{
  "name": "@samirdamle/nano-charts",
  "version": "0.1.0",
  "description": "Extremely lightweight, zero-dependency TypeScript library for tiny SVG charts.",
  "keywords": [
    "charts",
    "svg",
    "sparklines",
    "data-visualization",
    "visualization",
    "microcharts",
    "tiny",
    "zero-dependency"
  ],
  "license": "MIT",
  "author": "Samir Damle <damlemail@gmail.com>",
  "bugs": {
    "url": "https://github.com/samirdamle/nano-charts/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samirdamle/nano-charts.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/samirdamle/nano-charts#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./line": {
      "import": {
        "types": "./dist/line.d.ts",
        "default": "./dist/line.js"
      },
      "require": {
        "types": "./dist/line.d.cts",
        "default": "./dist/line.cjs"
      }
    },
    "./lines": {
      "import": {
        "types": "./dist/lines.d.ts",
        "default": "./dist/lines.js"
      },
      "require": {
        "types": "./dist/lines.d.cts",
        "default": "./dist/lines.cjs"
      }
    },
    "./area": {
      "import": {
        "types": "./dist/area.d.ts",
        "default": "./dist/area.js"
      },
      "require": {
        "types": "./dist/area.d.cts",
        "default": "./dist/area.cjs"
      }
    },
    "./bar": {
      "import": {
        "types": "./dist/bar.d.ts",
        "default": "./dist/bar.js"
      },
      "require": {
        "types": "./dist/bar.d.cts",
        "default": "./dist/bar.cjs"
      }
    },
    "./win-loss": {
      "import": {
        "types": "./dist/win-loss.d.ts",
        "default": "./dist/win-loss.js"
      },
      "require": {
        "types": "./dist/win-loss.d.cts",
        "default": "./dist/win-loss.cjs"
      }
    },
    "./bullet": {
      "import": {
        "types": "./dist/bullet.d.ts",
        "default": "./dist/bullet.js"
      },
      "require": {
        "types": "./dist/bullet.d.cts",
        "default": "./dist/bullet.cjs"
      }
    },
    "./donut": {
      "import": {
        "types": "./dist/donut.d.ts",
        "default": "./dist/donut.js"
      },
      "require": {
        "types": "./dist/donut.d.cts",
        "default": "./dist/donut.cjs"
      }
    },
    "./gauge": {
      "import": {
        "types": "./dist/gauge.d.ts",
        "default": "./dist/gauge.js"
      },
      "require": {
        "types": "./dist/gauge.d.cts",
        "default": "./dist/gauge.cjs"
      }
    },
    "./scatter": {
      "import": {
        "types": "./dist/scatter.d.ts",
        "default": "./dist/scatter.js"
      },
      "require": {
        "types": "./dist/scatter.d.cts",
        "default": "./dist/scatter.cjs"
      }
    },
    "./heatmap": {
      "import": {
        "types": "./dist/heatmap.d.ts",
        "default": "./dist/heatmap.js"
      },
      "require": {
        "types": "./dist/heatmap.d.cts",
        "default": "./dist/heatmap.cjs"
      }
    },
    "./to-svg": {
      "import": {
        "types": "./dist/to-svg.d.ts",
        "default": "./dist/to-svg.js"
      },
      "require": {
        "types": "./dist/to-svg.d.cts",
        "default": "./dist/to-svg.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "line": [
        "./dist/line.d.ts"
      ],
      "lines": [
        "./dist/lines.d.ts"
      ],
      "area": [
        "./dist/area.d.ts"
      ],
      "bar": [
        "./dist/bar.d.ts"
      ],
      "win-loss": [
        "./dist/win-loss.d.ts"
      ],
      "bullet": [
        "./dist/bullet.d.ts"
      ],
      "donut": [
        "./dist/donut.d.ts"
      ],
      "scatter": [
        "./dist/scatter.d.ts"
      ],
      "heatmap": [
        "./dist/heatmap.d.ts"
      ],
      "to-svg": [
        "./dist/to-svg.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsup",
    "postbuild": "node ../../scripts/verify-dist.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "size": "size-limit",
    "prepublishOnly": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build && pnpm run size && pnpm run publint",
    "publint": "pnpm dlx publint@0.3.24"
  },
  "dependencies": {},
  "devDependencies": {
    "@size-limit/preset-small-lib": "^11.1.6",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "size-limit": "^11.1.6",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
